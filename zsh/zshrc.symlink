# zmodload zsh/zprof

# Path to your oh-my-zsh configuration.
ZSH=$HOME/.oh-my-zsh
DOTFILES=$HOME/.dotfiles

# Starship config
export STARSHIP_CONFIG=$DOTFILES/starship/config.toml

# Set LunarVim as the editor
export EDITOR=lvim

# Specify your defaults in this environment variable
export HOMEBREW_CASK_OPTS="--appdir=/Applications"

# Terraform Debug
export TF_LOG=
export TF_LOG_PATH=
export TF_INPUT=

export ANSIBLE_COW_SELECTION=random

# Go config
export GOPATH=$HOME/go
export GOBIN="$GOPATH/bin"
export GOROOT=/usr/local/opt/go/libexec

# tj/n config
export N_PREFIX="/usr/local/n"

# Set the PATH
PATH="/usr/local/bin:$PATH"
PATH="/usr/local/sbin:$PATH"
PATH="/usr/local/opt/curl/bin:$PATH"
PATH="/usr/local/opt/bc/bin:$PATH"
PATH="./node_modules/.bin:$PATH"
PATH="../node_modules/.bin:$PATH"
PATH=$DOTFILES/bin:$PATH
PATH=$PATH:/usr/local/share/npm/lib/node_modules # Add Node modules
PATH=$PATH:/usr/local/share/npm/bin # Add node binaries to PATH
PATH=$PATH:/usr/local/aws/bin
PATH="/usr/local/opt/coreutils/libexec/gnubin:$PATH"
PATH=$PATH:$GOBIN
PATH="$PATH:./vendor/bin"
PATH=$PATH:$HOME/.composer/vendor/bin # Add composer stuff to PATH
PATH="/usr/local/opt/php@7.2/bin:$PATH"
PATH="/usr/local/opt/php@7.2/sbin:$PATH"
PATH=$PATH:~/Work/bin
PATH=$PATH:~/Code/GitHub/nathanielks/docker-cli-helpers/bin
PATH=$PATH:.
PATH=$PATH:../bin
PATH=$PATH:../../bin
PATH=$PATH:"/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
PATH="$N_PREFIX/bin:$PATH"  # Added by n-install (see http://git.io/n-install-repo).
PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"
PATH="/usr/local/opt/php@7.3/bin:$PATH"
PATH=$PATH:~/Work/bin
PATH=$PATH:~/Code/GitHub/nathanielks/docker-cli-helpers/bin
PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"
PATH="$PATH:/usr/local/opt/mysql@5.7/bin"
PATH="$PATH:$HOME/.local/bin"
#PATH="$PATH:$HOME/Library/Python/3.9/bin"
PATH="$PATH:/usr/local/lima/bin"
if [ -d "/usr/local/adb-fastboot/platform-tools" ] ; then
 PATH="/usr/local/adb-fastboot/platform-tools:$PATH"
fi
export PATH

LIBRARY_PATH="/usr/local/opt"
export LIBRARY_PATH

setopt auto_cd
cdpath=($GOPATH)

# QMK
export QMK_HOME=$HOME/Code/GitHub/nathanielks/qmk_firmware


# oh-my-zsh
plugins=(aws fzf git git-extras git-prompt gitfast zsh-autosuggestions zsh-completions ssh-agent)
source $ZSH/oh-my-zsh.sh

unsetopt correct_all

# Tmuxinator
[[ -s $HOME/.tmuxinator/scripts/tmuxinator ]] && source $HOME/.tmuxinator/scripts/tmuxinator

# source every *.zsh file in the repo
for file ($DOTFILES/zsh/*.zsh) source $file

[[ -f $HOME/.zshrc.local ]] && . $HOME/.zshrc.local
[[ -f $HOME/.zshrc.env ]] && . $HOME/.zshrc.env

# use .zshrc.local for settings specific to one system
fpath=(~/.zsh/completions $fpath)

autoload -Uz compinit
# This is Mac OS specific (I'm using gnucoreutils, so `stat` is diffeernt
if [ $(date +'%j') != $(/usr/bin/stat -f '%Sm' -t '%j' ~/.zcompdump) ]; then
  compinit
else
  compinit -C
fi

# FZF tab completion
source $HOME/.oh-my-zsh/custom/plugins/fzf-tab-completion/zsh/fzf-zsh-completion.sh
# only aws command completion
# zstyle ':completion:*:*:aws' fzf-search-display true
# or for everything
zstyle ':completion:*' fzf-search-display true

# AWS
export AWS_PAGER=
source /usr/local/share/zsh/site-functions/_aws

# libicu detection
#export LDFLAGS="-L/usr/local/opt/icu4c/lib"
#export CPPFLAGS="-I/usr/local/opt/icu4c/include"

autoload bashcompinit
bashcompinit

# ZSH Completions
fpath=(/usr/local/share/zsh-completions $fpath)

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"


if type rg &> /dev/null; then
  export FZF_DEFAULT_COMMAND='rg --files --hidden'
fi

eval "$(zoxide init zsh)"
eval "$(direnv hook zsh)"
eval $(thefuck --alias)
eval "$(hub alias -s)"

eval "$(starship init zsh)"


export ZEPHYR_TOOLCHAIN_VARIANT="gnuarmemb"
export GNUARMEMB_TOOLCHAIN_PATH="$HOME/Code/zmk/gcc-arm"

export ZMK_FIRMWARE_DIR="/Users/aang/Code/zmk/firmware"
export ZMK_CONFIG_DIR="/Users/aang/Code/zmk/zmk-config/config"

function dwest() {
  WORKDIR="/workspaces/firmware"
  if [[ "$1" == "build" ]]; then
    WORKDIR="/workspaces/firmware/app"
  fi

  docker run --rm \
    -w "$WORKDIR" \
    -v "$ZMK_FIRMWARE_DIR:/workspaces/firmware" \
    -v "$ZMK_CONFIG_DIR:/workspaces/zmk-config" \
    west west $1 ${@:2}
    # zmkfirmware/zephyr-west-action-arm $1 ${@:2}
}

alias zbl="dwest build -p -d build/left -b nice_nano -- -DSHIELD=tbk_mini_left -DZMK_CONFIG=/workspaces/zmk-config"
alias zbr="dwest build -p -d build/right -b nice_nano -- -DSHIELD=tbk_mini_right -DZMK_CONFIG=/workspaces/zmk-config"
alias zcl="cp $ZMK_FIRMWARE_DIR/app/build/left/zephyr/zmk.uf2 /Volumes/NICENANO"
alias zcr="cp $ZMK_FIRMWARE_DIR/app/build/right/zephyr/zmk.uf2 /Volumes/NICENANO"

# tabtab source for electron-forge package
# uninstall by removing these lines or running `tabtab uninstall electron-forge`
[[ -f /Users/aang/.npm/_npx/6913fdfd1ea7a741/node_modules/tabtab/.completions/electron-forge.zsh ]] && . /Users/aang/.npm/_npx/6913fdfd1ea7a741/node_modules/tabtab/.completions/electron-forge.zsh
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
eval "$(pyenv init -)"

source /Users/aang/.config/broot/launcher/bash/br
